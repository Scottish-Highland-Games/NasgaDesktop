<Window x:Class="NasgaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NasgaDesktop"
        mc:Ignorable="d"
        Title="NASGA Desktop" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
        </Grid.ColumnDefinitions>
        <TabControl SelectionChanged="TabControl_SelectionChanged" Grid.ColumnSpan="2">
            <TabItem Header="Home" BorderBrush="#FF6699CC">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FF6699CC" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid Background="#cccc99">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding HomeTabMessage}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="24" Width="195" Margin="10,10,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="Games" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Width="48">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FF6699CC" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid Background="#cccc99">
                    <Button Content="Calendar" HorizontalAlignment="Left" Margin="10,31,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click" Height="20"/>
                    <Button Content="Location" HorizontalAlignment="Left" Margin="10,56,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_1" Height="20"/>
                    <TextBlock Margin="10,10,0,0" TextWrapping="Wrap" Text="Search by" VerticalAlignment="Top" Height="16" Width="93" HorizontalAlignment="Left" TextAlignment="Center"/>
                    <Button Content="Classes" HorizontalAlignment="Left" Margin="10,81,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click" Height="20"/>
                    <Button Content="Save Local" HorizontalAlignment="Left" Margin="10,174,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_7" Height="20"/>
                    <Button Content="My Games" HorizontalAlignment="Left" Margin="10,149,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_5" Height="20"/>
                    <StackPanel/>
                    <Button Content="Sync to&#xD;&#xA;offline DB" HorizontalAlignment="Left" Margin="10,199,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_4" Height="41" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" UseLayoutRounding="False" />
                    <DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="122,0,0,0" x:Name="GamesDataGrid" />
                    <Button Content="Sync to&#xA;CLOUD DB" HorizontalAlignment="Left" Margin="10,245,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_6" Height="41" />
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Athletes" VerticalAlignment="Center" Width="54">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FF6699CC" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid Background="#cccc99"/>
            </TabItem>
            <TabItem Height="20" Header="Settings" VerticalAlignment="Top" Margin="0,0,0,0">
                <TabItem.Background>
                    <LinearGradientBrush EndPoint="0,1">
                        <GradientStop Color="#FFF0F0F0"/>
                        <GradientStop Color="#FF6699CC" Offset="1"/>
                    </LinearGradientBrush>
                </TabItem.Background>
                <Grid Background="#cccc99">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0*"/>
                        <ColumnDefinition Width="58*"/>
                        <ColumnDefinition Width="339*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
            <Border BorderBrush="Black" BorderThickness="1" Height="118" Width="93">
                <Border/>
            </Border>
        </TabControl>
    </Grid>
</Window>
