<Window x:Class="NasgaDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NasgaDesktop"
        mc:Ignorable="d"
        Title="NASGA Desktop" Height="450" Width="800">
    <Grid>
        <TabControl>
            <TabItem Header="Home">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="Games">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62*"/>
                        <ColumnDefinition Width="335*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Calendar" HorizontalAlignment="Left" Margin="10,31,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click"/>
                    <Button Content="Location" HorizontalAlignment="Left" Margin="10,56,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="31,10,0,0" TextWrapping="Wrap" Text="Search by" VerticalAlignment="Top"/>
                    <Button Content="Classes" HorizontalAlignment="Left" Margin="10,81,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click"/>
                    <TextBlock HorizontalAlignment="Left" Margin="33,128,0,0" TextWrapping="Wrap" Text="My Games" VerticalAlignment="Top"/>
                    <Button Content="Edit" HorizontalAlignment="Left" Margin="10,174,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_4"/>
                    <Button Content="New" HorizontalAlignment="Left" Margin="10,199,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_3"/>
                    <Button Content="All" HorizontalAlignment="Left" Margin="10,149,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_5"/>
                    <Button Content="Edit" HorizontalAlignment="Left" Margin="10,224,0,0" VerticalAlignment="Top" Width="93" Click="Button_Click_2"/>
                </Grid>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Athletes" VerticalAlignment="Center" Width="54">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem HorizontalAlignment="Center" Height="20" Header="Settings" VerticalAlignment="Center" Width="54">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21*"/>
                        <ColumnDefinition Width="227*"/>
                        <ColumnDefinition Width="546*"/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
